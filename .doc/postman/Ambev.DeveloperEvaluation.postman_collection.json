    {
      "name": "03 - Sales - Update",
      "item": [
        {
          "name": "Update sale (full item replacement)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"saleDate\": \"2026-08-25T10:00:00Z\",\n  \"customerId\": \"11111111-1111-1111-1111-111111111111\",\n  \"customerName\": \"Acme Corp Updated\",\n  \"branchId\": \"22222222-2222-2222-2222-222222222222\",\n  \"branchName\": \"Downtown Branch\",\n  \"items\": [\n    { \"productId\": \"33333333-3333-3333-3333-333333333333\", \"productName\": \"Beer Can 350ml\", \"unitPrice\": 5.00, \"quantity\": 9 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/Sales/{{saleId}}", "host": ["{{baseUrl}}"], "path": ["api", "Sales", "{{saleId}}"] },
            "description": "Replaces the sale's items entirely — the old {{itemId}} captured earlier no longer exists after this call."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('10% discount applied for 9 units', function () {",
                  "    pm.expect(pm.response.json().data.items[0].discount).to.equal(0.10);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.items && json.data.items.length) {",
                  "    pm.collectionVariables.set('itemId', json.data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
